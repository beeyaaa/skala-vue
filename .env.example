# 이 파일은 값이 비어 있는 템플릿입니다. 실제 키는 .env.local 에만 넣습니다.
#   cp .env.example .env.local
#
# 주의: VITE_ 접두사를 붙이지 않습니다.
#       접두사가 붙으면 값이 브라우저 번들에 그대로 포함됩니다.
#       두 키 모두 api/ 의 서버리스 함수에서만 사용합니다.

# OpenWeatherMap - 현재 날씨 / 예보 / 대기질 / 지역 검색
# https://openweathermap.org/api 에서 발급
OPENWEATHER_API_KEY=

# 기상청 API 허브 - 기상특보 현황
# API 허브에서 '특보현황 조회' 활용 신청 후 발급
KMA_API_KEY=
